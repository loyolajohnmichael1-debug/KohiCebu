# KohiCebu environment configuration example
# Copy this file to .env and replace placeholders with local values.
# Never commit your real .env file.

DB_HOST=127.0.0.1
DB_PORT=5432
DB_SSLMODE=disable
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=replace_with_your_local_password

# Path to your Firebase service-account JSON file.
# Keep the JSON file outside the public repository.
FIREBASE_CREDENTIALS_PATH=replace_with_your_local_credentials_path
